{
  "name": "hiveagents-kanban-tutorial",
  "version": "1.0.0",
  "private": true,
  "description": "Tablero Kanban de escritorio con entregables y revisión de agentes",
  "type": "module",
  "main": "src/main.mjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "test:desktop": "node --test --test-concurrency=1 tests/*.e2e.mjs",
    "labs": "node --test --test-reporter=spec tests/labs.test.mjs",
    "demo:replay": "node scripts/replay.mjs",
    "demo:live": "node tests/live-demo.mjs"
  },
  "engines": {"node": ">=22.16.0"},
  "dependencies": {"hiveagents-runtime": "0.1.0-beta.3"},
  "devDependencies": {"electron": "45.4.1", "playwright-core": "1.65.1"}
}
